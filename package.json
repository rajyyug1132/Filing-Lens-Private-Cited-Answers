{
  "name": "filing-lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "vendor": "node scripts/vendor-assets.mjs",
    "prebuild": "node scripts/vendor-assets.mjs",
    "build": "next build",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/Filing-Lens-Private-Cited-Answers next build && touch out/.nojekyll",
    "postinstall": "node scripts/vendor-assets.mjs",
    "serve": "http-server out -p 4173 -a 127.0.0.1 -c-1",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test tests/e2e/flow.spec.ts",
    "demo:record": "playwright test tests/e2e/demo.spec.ts",
    "bench": "tsx bench/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cyberlangke/tokkit-qwen": "^1.11.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "http-server": "^14.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "@ryanstark24/sfgraph-models": "^1.1.3",
    "@wllama/wllama": "^3.8.1",
    "@xenova/transformers": "^2.17.2",
    "idb": "^8.0.3",
    "next": "^16.3.8",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
